   "source": [
    "def mean_absolute_deviation(*args):\n",
    "    mean = sum(args)/len(args)\n",
    "    deviations = [abs(val - mean) for val in args]\n",
    "    return sum(deviations)/len(deviations)\n",
    "\n",
    "print(mean_absolute_deviation(5,7,8,10,10))"
   ]
  },
